<?xml version="1.0" encoding="UTF-8"?>
<!-- 国开版沿用智开的权限声明，独立名称与 bundle ID 防止品牌身份冲突。
     版本号仍由品牌脚本从 build/config.yml 注入。 -->
<plist version="1.0">
<dict>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleName</key>
    <string>智开（国开版）</string>
    <key>CFBundleExecutable</key>
    <string>智开（国开版）</string>
    <key>CFBundleIdentifier</key>
    <string>cn.ouconline.ai.zhikai.guokai</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleGetInfoString</key>
    <string>An open-source AI coding companion (desktop)</string>
    <key>CFBundleIconFile</key>
    <string>icons.icns</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 国家开放大学</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- 录音纪要要用的两项授权。
         麦克风走 CoreAudio，系统声音走 ScreenCaptureKit（见 internal/audio）。
         缺了这两句的表现不是弹框被拒，而是**系统直接终止进程**——TCC 要求任何
         触及这两类数据的应用都必须先声明用途。 -->
    <key>NSMicrophoneUsageDescription</key>
    <string>需要使用麦克风，以便录制会议中你这一侧的声音。</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>需要录制系统正在播放的声音，以便把会议中对方的发言一并整理成纪要。</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>需要访问你选择的工作区目录，以便读取与修改其中的文件。</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>需要访问你选择的工作区目录，以便读取与修改其中的文件。</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>需要访问你选择的工作区目录，以便读取与修改其中的文件。</string>
</dict>
</plist>
